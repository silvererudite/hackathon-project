# Copy to config.env and edit before submitting run_llm.sh
#
# Get the full Slurm account name:
#   sacctmgr show assoc user=$USER format=User,Account%40,QOS%50

SLURM_ACCOUNT=hans-hydro-ml
HF_HOME=/rds/projects/h/hans-hydro-ml/Current_project/fin_sum_school/huggingface
TRANSFORMERS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: point directly at your data folder (must contain metrics.csv + scores.csv)
# SCIOPS_DATA_DIR=/rds/projects/h/hans-hydro-ml/Current_project/fin_sum_school/hackathon-project/data

# Keep pip --user packages on RDS (not home)
export PYTHONUSERBASE=/rds/projects/h/hans-hydro-ml/Python_library
export PATH="${PYTHONUSERBASE}/bin:${PATH}"

# Only needed for gated models (Meta Llama, etc.):
# HF_TOKEN=hf_...
